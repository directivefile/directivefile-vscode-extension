{
  "$schema": "vscode://schemas/language-configuration",
  "comments": {
    "lineComment": { "comment": "#" }
  },
  "brackets": [
    ["{", "}"]
  ],
  "autoClosingPairs": [
    { "open": "{", "close": "}", "notIn": ["string", "comment"] },
    { "open": "\"", "close": "\"", "notIn": ["string", "comment"] },
    { "open": "`", "close": "`", "notIn": ["string", "comment"] }
  ],
  "surroundingPairs": [
    ["{", "}"],
    ["\"", "\""],
    ["`", "`"]
  ],
  "wordPattern": "[^\\s\"`#{}]+",
  "indentationRules": {
    "increaseIndentPattern": "^.*\\{[ \\t]*(?:#.*)?$",
    "decreaseIndentPattern": "^\\s*\\}"
  }
}
