{
  "name": "df",
  "displayName": "Directivefile",
  "description": "Syntax highlighting and formatting for Directivefile configuration files.",
  "version": "0.0.8",
  "publisher": "directivefile",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/directivefile/directivefile-vscode-extension"
  },
  "categories": [
    "Programming Languages",
    "Formatters"
  ],
  "keywords": [
    "directivefile",
    "formatter"
  ],
  "icon": "./icons/extension-icon.png",
  "contributes": {
    "languages": [
      {
        "id": "directivefile",
        "aliases": [
          "Directivefile"
        ],
        "extensions": [
          ".df"
        ],
        "configuration": "./directivefile.configuration.json",
        "icon": {
          "light": "./icons/directivefile-light.png",
          "dark": "./icons/directivefile-dark.png"
        }
      }
    ],
    "grammars": [
      {
        "language": "directivefile",
        "scopeName": "source.directivefile",
        "path": "./syntaxes/directivefile.tmLanguage.json",
        "tokenTypes": {
          "comment.line.number-sign.directivefile": "comment",
          "string.quoted.double.directivefile": "string",
          "string.quoted.other.backtick.directivefile": "string"
        }
      }
    ],
    "configuration": {
      "title": "Directivefile",
      "properties": {
        "directivefile.format.printWidth": {
          "type": "number",
          "default": 120,
          "minimum": 1,
          "scope": "resource",
          "description": "Maximum line width used by the Directivefile formatter."
        },
        "directivefile.format.maxBlankLines": {
          "type": "integer",
          "default": 1,
          "minimum": 0,
          "scope": "resource",
          "description": "Maximum number of blank lines kept between directives and comments."
        }
      }
    }
  },
  "engines": {
    "vscode": "^1.146.0"
  },
  "type": "module",
  "main": "./dist/extension.js",
  "scripts": {
    "vscode:prepublish": "npm run build",
    "build": "tsc && vite build",
    "typecheck": "tsc",
    "watch": "vite build --watch",
    "package": "vsce package"
  },
  "devDependencies": {
    "@types/vscode": "^1.146.0",
    "@vscode/vsce": "^4.1.1",
    "antlr4": "^4.13.2",
    "prettier": "^3.10.1",
    "typescript": "~7.0.2",
    "vite": "^8.3.6"
  }
}